# ============================================================
# AttendX Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=attendx_db
DB_CONNECTION_LIMIT=10

# ── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ─
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Email (SMTP) ─────────────────────────────────────────────
# Gmail: use an App Password (not your login password)
#   myaccount.google.com → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=no-reply@attendx.ac.rw
APP_URL=http://localhost:5173

# ── FCM (Firebase Cloud Messaging) ───────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FCM_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
FCM_CHANNEL_ID=attendx_main
FCM_BATCH_SIZE=500
BULK_WARNING_DELAY_MS=500

# ── IP Intelligence / VPN Detection ──────────────────────────
# Free key at https://ipdata.co  (leave blank to use ip-api.com fallback)
IPDATA_API_KEY=

# ── Session & Attendance Logic ────────────────────────────────
SESSION_TTL_MINUTES=90
LATE_THRESHOLD_MINUTES=15
QR_TOKEN_WINDOW_SECONDS=30
ATTENDANCE_WARNING_THRESHOLD=75
DEFAULT_RADIUS_M=50

# ── Security / Auth ───────────────────────────────────────────
MIN_PASSWORD_LENGTH=8

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
GENERAL_RATE_LIMIT_MAX=200
CHECKIN_RATE_LIMIT_MAX=10
CHECKIN_WINDOW_MS=60000

# ── Cron Jobs ─────────────────────────────────────────────────
WEEKLY_DIGEST_SCHEDULE=0 7 * * 1
CRON_TIMEZONE=Africa/Kigali
