# ============================================================
# AttendX — PRODUCTION Environment
# Run: node scripts/generate-secrets.js  to get fresh secrets
# ============================================================

PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=attendx_user
DB_PASSWORD=CHANGE_TO_STRONG_DB_PASSWORD
DB_NAME=attendx_db
DB_CONNECTION_LIMIT=20

# ── JWT (generate with: node scripts/generate-secrets.js) ────
JWT_SECRET=PASTE_GENERATED_SECRET_HERE
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=PASTE_GENERATED_REFRESH_SECRET_HERE
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── CORS — replace with your actual domain ───────────────────
CORS_ORIGIN=https://admin.attendx.ac.rw,https://lecturer.attendx.ac.rw

# ── Email ────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.YOUR_SENDGRID_API_KEY
EMAIL_FROM=no-reply@attendx.ac.rw
APP_URL=https://admin.attendx.ac.rw

# ── FCM ──────────────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
FCM_CHANNEL_ID=attendx_main
FCM_BATCH_SIZE=500
BULK_WARNING_DELAY_MS=300

# ── VPN Detection ─────────────────────────────────────────────
IPDATA_API_KEY=YOUR_IPDATA_KEY_HERE

# ── Session & Attendance ──────────────────────────────────────
SESSION_TTL_MINUTES=90
LATE_THRESHOLD_MINUTES=15
QR_TOKEN_WINDOW_SECONDS=30
ATTENDANCE_WARNING_THRESHOLD=75
DEFAULT_RADIUS_M=50

# ── Security ─────────────────────────────────────────────────
MIN_PASSWORD_LENGTH=8

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
GENERAL_RATE_LIMIT_MAX=300
CHECKIN_RATE_LIMIT_MAX=5
CHECKIN_WINDOW_MS=60000

# ── DB Pool ───────────────────────────────────────────────────
DB_CONNECTION_LIMIT=20

# ── Cron ─────────────────────────────────────────────────────
WEEKLY_DIGEST_SCHEDULE=0 7 * * 1
CRON_TIMEZONE=Africa/Kigali
